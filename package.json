    "preview": "electron-vite preview",
    "dist": "npm run build && npm run bundle:models && electron-builder",
    "dist:win": "npm run build && npm run bundle:models && electron-builder --win",
    "dist:win-portable": "npm run build && npm run bundle:models && electron-builder --win portable",
    "dist:mac": "npm run build && npm run bundle:models && electron-builder --mac",
    "dist:linux": "npm run build && npm run bundle:models && electron-builder --linux",
    "dist:all": "npm run build && npm run bundle:models && electron-builder --win nsis portable --mac --linux",
    "typecheck": "tsc --noEmit",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "test": "jest --config jest.config.cjs --passWithNoTests",
    "test:watch": "jest --config jest.config.cjs --watch",
    "lint": "eslint src electron --ext .ts,.tsx",
    "generate-icons": "node assets/generate-icons-from-svg.js",
    "update-vendor": "node scripts/update-vendor-packages.js",
    "bundle:models": "node scripts/download-models.js"
  },
